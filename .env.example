# AI Video Director — copy this file to `.env` and fill in your keys.
#   cp .env.example .env
# `.env` is gitignored (your keys never get committed).

# kie.ai — generation (Gemini Omni video + GPT-Image-2 graphics). Get it at https://kie.ai → API keys
KIE_API_KEY=

# OpenRouter — analysis (Gemini 3.5 Flash reads your video). Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the kie base URL (rarely needed)
# KIE_BASE_URL=https://api.kie.ai
